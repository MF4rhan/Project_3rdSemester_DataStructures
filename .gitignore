.vscode/
*.code-workspace
.history/

# Language server & linter caches (Clangd, ccls)
.cache/
.clangd/
compile_commands.json

# ==============================================================================
# LINUX ARTIFACTS & EDITORS
# ==============================================================================
# Core dumps & profiler logs
core
core.*
vgcore.*
valgrind.log*
gmon.out

# KDE Dolphin / system directory settings
.directory

# Common terminal editor swaps (Nano, Vim, Kate)
*~
*.swp
*.swo
*.swn
.*.sw?
*.kate-swp

